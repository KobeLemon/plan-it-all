@using software_dev_portfolio.Pages.PageComponents;

<div class="contact-list">
    @foreach (var item in ContactsList)
    {
        <ContactItemComponent Link="@item.Link" Description="@item.Description" ImagePath="@item.ImagePath" ImageAlt="@item.ImageAlt"/>
    }
</div>

@code {
    private List<ContactItem>? ContactsList = new List<ContactItem>
    {
        new ContactItem
        {
            Link="mailto:kobealemon@gmail.com",
            Description="✉ kobealemon@gmail.com",
            ImagePath=string.Empty,
            ImageAlt=string.Empty
        },
        new ContactItem
        {
            Link="https://www.linkedin.com/in/kobe-lemon",
            Description="LinkedIn",
            ImagePath="/images/linkedin-original.svg",
            ImageAlt="LinkedIn Logo"
        },
        new ContactItem
        {
            Link="https://github.com/KobeLemon",
            Description="GitHub",
            ImagePath="./images/github-original.svg",
            ImageAlt="GitHub Logo"
        },
    };

    public class ContactItem
    {
        public string? Link { get; set; }
        public string? Description { get; set; }
        public string? ImagePath { get; set; }
        public string? ImageAlt { get; set; }
    }
}
