<div class="portal-item">
    <a href="@Link">@Name</a>
    <section>
        <img class="projectImage" src="/images/@ImageLink" alt="@AltText" />
        <p style="text-align: justify;">
            @Description
            <br /><br />Technologies: @FormattedTechnologies
        </p>
    </section>
</div>

@code {
    [Parameter]
    public string? Name { get; set; }
    [Parameter]
    public string? Link { get; set; }
    [Parameter]
    public string? Description { get; set; }
    [Parameter]
    public List<string>? Technologies { get; set; }
    [Parameter]
    public string? ImageLink { get; set; }
    [Parameter]
    public string? AltText { get; set; }
    private string? FormattedTechnologies => string.Join(", ", Technologies);
}
