<hr />

<div class="project-items-list">

    @foreach (var item in SortedProjectItems)
    {
        <ProjectItemComponent 
            Link="@item.Link"
            Description="@item.Description"
            Technologies="@item.Technologies"
            Name="@item.Name"
            ImageLink="@item.ImageLink"
            AltText="@item.AltText"
        />
    }
    <div style="text-align:center;"><a href="/projects">Back to Top</a></div>
</div>

@code {
    public string? Title = string.Empty;
    private string? CurrentSort = "default";
    private List<ProjectItem>? SortedProjectItems;

    private List<ProjectItem>? ProjectItems = new List<ProjectItem>
    {
        new ProjectItem {
            Name = "Maze Bouncer - Demo Video Game",
            Link = "https://github.com/KobeLemon/maze-bouncer",
            Description="This is Maze Bouncer, a video game where you control a constantly bouncing ball as you navigate increasingly complex mazes. You wield your prodigious springiness to ricochet throughout labyrinths & find the exit! \n\nThis uses free assets from Brackey's \"First Game in Godot\" tutorial & from Itch.io, but the overall game itself is my creation. This is a proof-of-concept demo, design of final product will differ.",
            Technologies = new List<string> {"Godot Game Engine", "GDScript", "C#", "Audio/Visual Mixer"},
            ImageLink = "maze_bouncer_preview.png",
            AltText = "Preview of Maze Bouncer Video Game",
        },
        new ProjectItem {
            Name = "Where Am I? - Geolocator & Weather",
            Link = "https://kobelemon.github.io/geolocator-app/",
            Description="Where Am I? - Geolocator & Weather uses the Geolocation API and the OpenWeather API to show your current location and the weather data for your current location. You can keep track of the location data & weather data by saving it into browser Local Storage. No personal data is saved/accessible elsewhere.",
            Technologies = new List<string> {"HTML", "CSS", "JavaScript", "Geolocation API", "OpenWeather API, LocalStorage"},
            ImageLink = "where_am_I_preview.png",
            AltText = "Preview of Where Am I? - Geolocator & Weather project",
        },
        new ProjectItem {
            Name = "Star Wars API - Demo App",
            Link = "https://kobelemon.github.io/swapi-demo-app/",
            Description="Star Wars API - Demo App uses SWAPI - The Star Wars API to display information about various characters, planets, etc. from the Star Wars universe. NOTE: I am not affiliated with SWAPI - The Star Wars API or its author Paul Hallett, Disney, or Lucasfilms. I am not using this project for monetary gain. This project is soley meant to exercise and practice my coding skills. SWAPI License: https://github.com/Juriy/swapi?tab=BSD-3-Clause-1-ov-file#readme",
            Technologies = new List<string> {"HTML", "CSS", "JavaScript", "SWAPI - The Star Wars API"},
            ImageLink = "swapi_preview.png",
            AltText = "Preview of Star Wars API - Demo App",
        },
        new ProjectItem {
            Name = "Bountiful Foods - Mock Website",
            Link = "/projects/bountiful-foods/index.html",
            Description="Bountiful Foods is a mock website I created while at BYU-Idaho. Interactive & designed to be a farmer's market website, showing the vision and directive with a clean UI. It uses the OpenWeather API to get accurate weather data for Carlsbad, CA.",
            Technologies = new List<string> {"HTML", "CSS", "JavaScript", "OpenWeather API"},
            ImageLink = "bountiful_foods_preview.png",
            AltText = "Preview of Bountiful Foods - Mock Website",
        },
        new ProjectItem {
            Name = "Chamber of Commerce - Mock Website",
            Link = "/projects/chamber/index.html",
            Description="This is a mock Chamber of Commerce website I created while at BYU-Idaho, it is a mock platform where citizens can collaborate together, advertise their businesses, see information about events and local, and see the local news. It has an organized business directory and uses smart form logic to register mock users/businesses.",
            Technologies = new List<string> {"HTML", "CSS", "JavaScript", "OpenWeather API"},
            ImageLink = "chamber_preview.png",
            AltText = "Preview of Chamber of Commerce - Mock Website",
        },
        new ProjectItem {
            Name = "Custom List Maker",
            Link = "/projects/list-maker/index.html",
            Description="This is a simple custom list maker for things like a to-do list, shopping list, reminders, etc. Hosted as a live website, so you can make a list anywhere anytime!",
            Technologies = new List<string> {"HTML", "CSS", "JavaScript"},
            ImageLink = "custom_list_maker_preview.png",
            AltText = "Preview of Custom List Maker",
        },
        new ProjectItem {
            Name = "CSS Keyframes Presentation",
            Link = "/projects/keyframes-presentation/index.html",
            Description="This is a CSS Keyframes Presentation I created while at BYU-Idaho. It illustrates and displays the many things you can do with CSS and its Keyframes system. JavaScript is used for the button event listeners, but the keyframe animations are purely CSS.",
            Technologies = new List<string> {"HTML", "CSS", "JavaScript"},
            ImageLink = "keyframes_presentation_preview.png",
            AltText = "Preview of CSS Keyframes Presentation",
        },
    };
    
    protected override void OnInitialized()
    {
        SortedProjectItems = ProjectItems;
    }

    // This function sorts projects according to user input
    private void SortProjects(ChangeEventArgs e)
    {
        CurrentSort = e.Value?.ToString();

        switch (CurrentSort)
        {
            // A-Z
            case "NameAsc":
                SortedProjectItems = ProjectItems?.OrderBy(p => p.Name).ToList();
                break;

            // Z-A
            case "NameDesc":
                SortedProjectItems = ProjectItems?.OrderByDescending(p => p.Name).ToList();
                break;

            // Default
            default:
                SortedProjectItems = ProjectItems;
                break;
        }
    }

    // Properties to track which sorting option is selected
    private bool IsDefault => CurrentSort?.ToLower() == "default";
    private bool IsNameAsc => CurrentSort?.ToLower() == "nameasc";
    private bool IsNameDesc => CurrentSort?.ToLower() == "namedesc";
    private bool IsTechnologies => CurrentSort?.ToLower() == "Technologies";

    public class ProjectItem
    {
        public string? Name { get; set; }
        public string? Link { get; set; }
        public string? Description { get; set; }
        public List<string>? Technologies { get; set; }
        public string? ImageLink { get; set; }
        public string? AltText { get; set; }
    }
}
